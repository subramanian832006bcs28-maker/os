[24bcs049@mepcolinux ex5]$cat common.h
#ifndef COMMON_H
#define COMMON_H

#define _XOPEN_SOURCE 700
#define _POSIX_C_SOURCE 200112L

#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <semaphore.h>
#include <unistd.h>

#define BUFFER_SIZE 5

// Suffix added to names to prevent collisions with other students on the server
#define SHM_NAME "/shm_24bcs049"
#define SEM_MUTEX "/sem_mutex_24bcs049"
#define SEM_EMPTY "/sem_empty_24bcs049"
#define SEM_FULL "/sem_full_24bcs049"

typedef struct {
    int buffer[BUFFER_SIZE];
    int in;
    int out;
} shared_data_t;

#endif

[24bcs049@mepcolinux ex5]$cat producer.c
#include "common.h"

int main() {
    // Clean up any stale instances from previous crashed runs
    shm_unlink(SHM_NAME);
    sem_unlink(SEM_MUTEX);
    sem_unlink(SEM_EMPTY);
    sem_unlink(SEM_FULL);

    // 1. Create and map shared memory
    int shm_fd = shm_open(SHM_NAME, O_CREAT | O_RDWR, 0666);
    if (shm_fd == -1) {
        perror("shm_open failed");
        exit(1);
    }
    ftruncate(shm_fd, sizeof(shared_data_t));
    shared_data_t *shared = (shared_data_t *)mmap(NULL, sizeof(shared_data_t), PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);

    // Reset circular buffer trackers
    shared->in = 0;
    shared->out = 0;

    // 2. Initialize Semaphores
    sem_t *mutex = sem_open(SEM_MUTEX, O_CREAT, 0666, 1);
    sem_t *empty = sem_open(SEM_EMPTY, O_CREAT, 0666, BUFFER_SIZE);
    sem_t *full = sem_open(SEM_FULL, O_CREAT, 0666, 0);

    printf("Producer started. (Enter -1 to exit)\n\n");

    int input_item;
    while (1) {
        printf("Enter an integer to produce: ");
        if (scanf("%d", &input_item) != 1) {
            printf("Invalid input. Please enter numbers only.\n");
            while (getchar() != '\n'); // Clear tracking line
            continue;
        }

        // Check for termination signal
        if (input_item == -1) {
            int empty_slots;
            sem_getvalue(empty, &empty_slots);

            // If buffer is entirely full, exit immediately instead of hanging
            if (empty_slots == 0) {
                printf("\nBuffer is full! Exiting producer directly without dropping -1.\n");
                break;
            }

            // Otherwise, drop the exit code into an available slot
            sem_wait(empty);
            sem_wait(mutex);
            shared->buffer[shared->in] = -1;
            shared->in = (shared->in + 1) % BUFFER_SIZE;
            sem_post(mutex);
            sem_post(full);
            break;
        }

        printf("[Waiting] Checking if buffer has empty space...\n");
        sem_wait(empty); // Will block here if empty_slots == 0
        sem_wait(mutex); 

        // Insert item into shared circular buffer
        shared->buffer[shared->in] = input_item; 
        printf(">> [Success] Produced: %d at index %d\n\n", shared->buffer[shared->in], shared->in);
        shared->in = (shared->in + 1) % BUFFER_SIZE;

        sem_post(mutex); 
        sem_post(full);  
    }

    // Free local process memory allocations
    munmap(shared, sizeof(shared_data_t));
    close(shm_fd);
    sem_close(mutex);
    sem_close(empty);
    sem_close(full);

    printf("Producer terminated successfully.\n");
    return 0;
}

[24bcs049@mepcolinux ex5]$cat consumer.c
#include "common.h"

int main() {
    int shm_fd = shm_open(SHM_NAME, O_RDWR, 0666);
    if (shm_fd == -1) {
        perror("Shared memory opening failed. Run producer first");
        exit(1);
    }
    shared_data_t *shared = (shared_data_t *)mmap(NULL, sizeof(shared_data_t), PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);

    sem_t *mutex = sem_open(SEM_MUTEX, 0);
    sem_t *empty = sem_open(SEM_EMPTY, 0);
    sem_t *full = sem_open(SEM_FULL, 0);

    printf("Consumer started. Waiting for items...\n\n");

    while (1) {
        int full_slots;
        sem_getvalue(full, &full_slots);

        // If producer finished and buffer is completely dry, terminate
        if (full_slots == 0) {
            // Check if shared memory tracking file was unlinked by producer
            struct stat shm_stat;
            if (fstat(shm_fd, &shm_stat) == -1 || shm_stat.st_nlink == 0) {
                break;
            }
        }

        sem_wait(full);  
        sem_wait(mutex); 

        int item = shared->buffer[shared->out];
        
        // Break out of loop if explicit termination code read
        if (item == -1) {
            sem_post(mutex);
            break;
        }

        printf("<< [Success] Consumed: %d from index %d\n", item, shared->out);
        shared->out = (shared->out + 1) % BUFFER_SIZE;

        sem_post(mutex); 
        sem_post(empty); 

        sleep(1); // Standby sleep to track consumption rhythm
    }

    // Clean up handles and unlink global references permanently
    munmap(shared, sizeof(shared_data_t));
    close(shm_fd);
    sem_close(mutex);
    sem_close(empty);
    sem_close(full);

    shm_unlink(SHM_NAME);
    sem_unlink(SEM_MUTEX);
    sem_unlink(SEM_EMPTY);
    sem_unlink(SEM_FULL);

    printf("\nConsumer detected exit condition. Shared system resources cleared.\n");
    return 0;
}

