[24bcs049@mepcolinux ex2]$cat ex2.c
#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <stdlib.h>

int main()
{
    int fd[2];
    pid_t pid;

    int num[2];
    int a, b, x, y, temp, gcd, lcm;

    pipe(fd);

    pid = fork();

    if (pid > 0)
    {
        close(fd[0]);

        printf("P1 - Enter two numbers: ");
        scanf("%d %d", &num[0], &num[1]);

        write(fd[1], num, sizeof(num));

        close(fd[1]);
    }
    else if (pid == 0)
    {
        close(fd[1]);

        read(fd[0], num, sizeof(num));

        close(fd[0]);

        a = num[0];
        b = num[1];

        x = a;
        y = b;

        while (y != 0)
        {
            temp = y;
            y = x % y;
            x = temp;
        }

        gcd = x;

        lcm = (a * b) / gcd;

        printf("\nLCM = %d\n", lcm);
    }
    else
    {
        printf("Fork failed\n");
    }

    return 0;
}


