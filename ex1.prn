[24bcs049@mepcolinux ex1]$cat ex3.c
#include <stdio.h>
#include <unistd.h>
#include <string.h>

char str[100];

int main()
{
    pid_t P2, P3;

    printf("Enter a String: ");
    fgets(str, sizeof(str), stdin);

    P2 = fork();

    if (P2 == 0)
    {
        int i, vowels = 0;

        for (i = 0; str[i] != '\0'; i++)
        {
            if (str[i] == 'a' || str[i] == 'e' ||
                str[i] == 'i' || str[i] == 'o' ||
                str[i] == 'u' || str[i] == 'A' ||
                str[i] == 'E' || str[i] == 'I' ||
                str[i] == 'O' || str[i] == 'U')
            {
                vowels++;
            }
        }

        printf("No. of vowels = %d\n", vowels);
    }
    else
    {
        P3 = fork();

        if (P3 == 0)
        {
            int i, special = 0;

            for (i = 0; str[i] != '\0'; i++)
            {
                if (!((str[i] >= 'A' && str[i] <= 'Z') ||
                      (str[i] >= 'a' && str[i] <= 'z') ||
                      (str[i] >= '0' && str[i] <= '9') ||
                      str[i] == ' ' || str[i] == '\n'))
                {
                    special++;
                }
            }

            printf("No. of Special Characters = %d\n", special);
        }
    }

    return 0;
}


