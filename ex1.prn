[24bcs049@mepcolinux ex1]$cat ex2.c
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h> 

int a[100], n;

int prime(int num)
{
    int i;

    if (num < 2)
        return 0;

    for (i = 2; i <= num / 2; i++)
    {
        if (num % i == 0)
            return 0;
    }

    return 1;
}

int main()
{
    pid_t p;
    int i;

    printf("Enter the size of the array: ");
    scanf("%d", &n);

    printf("Enter the array elements:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    p = fork();

    if (p == 0)
    {
        printf("[Child] Array received successfully.\n");
    }
    else
    {
        wait(NULL);

        printf("[Parent] Prime no. in the array are:\n");
        for (i = 0; i < n; i++)
        {
            if (prime(a[i]))
                printf("%d ", a[i]);
        }
        printf("\n");
    }

    return 0;
}

